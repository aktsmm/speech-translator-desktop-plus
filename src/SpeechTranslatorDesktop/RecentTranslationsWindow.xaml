<Window x:Class="SpeechTranslatorDesktop.RecentTranslationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TranslationsWindowTitle}"
        Height="420"
        Width="720"
        MinHeight="300"
        MinWidth="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="{Binding TranslationsWindowTitle}" />

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding RecentTranslationLogs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding SourceText}" />
                            <TextBlock Grid.Row="1"
                                       FontSize="16"
                                       TextWrapping="Wrap"
                                       Text="{Binding TranslatedText}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
