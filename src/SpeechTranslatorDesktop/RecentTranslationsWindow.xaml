<Window x:Class="SpeechTranslatorDesktop.RecentTranslationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TranslationsWindowTitle}"
        Icon="Assets/AppIcon.ico"
        Height="420"
        Width="720"
        MinHeight="300"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FB">
    <Window.Resources>
        <Style x:Key="NoteCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.07" ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="{Binding TranslationsWindowTitle}" />

        <ItemsControl Grid.Row="1"
                      AutomationProperties.Name="{Binding TranslationsWindowTitle}"
                      ItemsSource="{Binding RecentTranslationLogs}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="{x:Type ItemsControl}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Style="{StaticResource NoteCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,6"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding SourceText}" />
                             <TextBlock Grid.Row="1"
                                        FontSize="16"
                                        Visibility="{Binding DataContext.TranslationColumnVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                        TextWrapping="Wrap"
                                        Text="{Binding TranslatedText}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
