<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SpeechTranslatorDesktopPlus</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <Product>Speech Translator Desktop Plus</Product>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>SpeechTranslatorDesktop.App</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Speech.V2" Version="1.8.0" />
    <PackageReference Include="Google.Cloud.Translate.V3" Version="3.11.0" />
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <!-- Override the transitive 2.x bundle to replace the vulnerable SQLitePCLRaw.lib.e_sqlite3 native library. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <ProjectReference Include="..\Shared\SpeechTranslatorShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
