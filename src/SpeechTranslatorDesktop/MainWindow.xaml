<Window x:Class="SpeechTranslatorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpeechTranslatorDesktop.Behaviors"
        Title="Speech Translator Desktop Plus"
        Icon="Assets/AppIcon.ico"
        Height="760"
        Width="1120"
        MinHeight="620"
        MinWidth="900"
        Background="#F5F7FB">
    <Window.Resources>
        <local:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />

        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" Direction="270" Opacity="0.08" ShadowDepth="3" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="ActionButton" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="DangerButton" BasedOn="{StaticResource ActionButton}" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="Foreground" Value="#991B1B" />
        </Style>

        <Style x:Key="WrappedTranslationCellText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxHeight" Value="60" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="20"
                Background="#111827"
                CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               Text="Speech Translator Desktop Plus" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#CBD5E1"
                               Text="Azure AI Speech realtime captions, translation, and local notes." />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ComboBox Width="132"
                              ItemsSource="{Binding AvailableUiLanguages}"
                              SelectedItem="{Binding SelectedUiLanguage}"
                              AutomationProperties.Name="{Binding UiLanguageLabel}"
                              ToolTip="{Binding UiLanguageLabel}" />
                    <Button Margin="12,0,0,0"
                            Style="{StaticResource ActionButton}"
                            Click="ShowSettingsWindow"
                            AutomationProperties.Name="{Binding SettingsButtonText}"
                            ToolTip="{Binding SettingsButtonText}"
                            Content="{Binding SettingsButtonText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding RecognitionModeLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableRecognitionModes}"
                              SelectedItem="{Binding SelectedRecognitionMode}"
                              AutomationProperties.Name="{Binding RecognitionModeLabel}"
                              ToolTip="{Binding RecognitionModeLabel}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding SourceLanguageLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedSourceLanguage}"
                              AutomationProperties.Name="{Binding SourceLanguageLabel}"
                              ToolTip="{Binding SourceLanguageLabel}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding TargetLanguageLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedTargetLanguage}"
                              IsEnabled="{Binding IsTranslationMode}"
                              AutomationProperties.Name="{Binding TargetLanguageLabel}"
                              ToolTip="{Binding TargetLanguageLabel}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding AudioInputLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableAudioInputSources}"
                              SelectedItem="{Binding SelectedAudioInputSource}"
                              AutomationProperties.Name="{Binding AudioInputLabel}"
                              ToolTip="{Binding AudioInputLabel}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding RecordingFileNameLabel}" />
                    <TextBox AutomationProperties.Name="{Binding RecordingFileNameLabel}"
                             ToolTip="{Binding RecordingFileNameLabel}"
                             Text="{Binding RecordingFileName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <WrapPanel Grid.Row="1"
                           Grid.Column="2"
                           Grid.ColumnSpan="2"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Right">
                    <Button MinWidth="100"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCommand}"
                            AutomationProperties.Name="{Binding StartButtonText}"
                            ToolTip="{Binding StartButtonText}"
                            Content="{Binding StartButtonText}" />
                    <Button MinWidth="100"
                            Margin="0,0,8,0"
                            Style="{StaticResource ActionButton}"
                            Command="{Binding StopCommand}"
                            AutomationProperties.Name="{Binding StopButtonText}"
                            ToolTip="{Binding StopButtonText}"
                            Content="{Binding StopButtonText}" />
                    <Button MinWidth="110"
                            Margin="0,0,8,0"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding ClearLogsCommand}"
                            AutomationProperties.Name="{Binding ClearLogsButtonText}"
                            ToolTip="{Binding ClearLogsButtonText}"
                            Content="{Binding ClearLogsButtonText}" />
                    <Button MinWidth="190"
                            Style="{StaticResource ActionButton}"
                            Click="ShowRecentTranslationsWindow"
                            AutomationProperties.Name="{Binding ShowRecentTranslationsButtonText}"
                            ToolTip="{Binding ShowRecentTranslationsButtonText}"
                            Content="{Binding ShowRecentTranslationsButtonText}" />
                </WrapPanel>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Margin="0,14,0,0"
                        Padding="10,6"
                        HorizontalAlignment="Left"
                        Background="#EFF6FF"
                        CornerRadius="10"
                        AutomationProperties.Name="{Binding StatusLabel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="#1D4ED8"
                                   Text="{Binding StatusLabel}" />
                        <TextBlock Margin="8,0,0,0"
                                   Foreground="#1E3A8A"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Margin="0,0,0,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,12"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{Binding TranslationLogHeader}" />
                <DataGrid ItemsSource="{Binding TranslationLogs}"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0">
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="MaxHeight" Value="72" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding SourceText}"
                                            ElementStyle="{StaticResource WrappedTranslationCellText}"
                                            Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding Data.SourceTextHeader, Source={StaticResource DataContextProxy}}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding TranslatedText}"
                                            ElementStyle="{StaticResource WrappedTranslationCellText}"
                                            Visibility="{Binding Data.TranslationColumnVisibility, Source={StaticResource DataContextProxy}}"
                                            Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding Data.TranslatedTextHeader, Source={StaticResource DataContextProxy}}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,8"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{Binding StatusLogHeader}" />
                <ListBox ItemsSource="{Binding ActivityLogs}"
                         BorderThickness="0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
