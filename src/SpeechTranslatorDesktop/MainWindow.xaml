<Window x:Class="SpeechTranslatorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpeechTranslatorDesktop.Behaviors"
        x:Name="RootWindow"
        Title="Speech Translator Desktop Plus"
        Height="700"
        Width="960"
        MinHeight="480"
        MinWidth="720">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,12,12">
            <TextBlock FontWeight="Bold" Text="{Binding SourceLanguageLabel}" />
            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                      SelectedItem="{Binding SelectedSourceLanguage}"
                      AutomationProperties.Name="{Binding SourceLanguageLabel}"
                      ToolTip="{Binding SourceLanguageLabel}"
                      Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Margin="12,0,0,12">
            <TextBlock FontWeight="Bold" Text="{Binding TargetLanguageLabel}" />
            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                      SelectedItem="{Binding SelectedTargetLanguage}"
                      AutomationProperties.Name="{Binding TargetLanguageLabel}"
                      ToolTip="{Binding TargetLanguageLabel}"
                      Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,12,12">
            <TextBlock FontWeight="Bold" Text="{Binding RecordingFileNameLabel}" />
            <TextBox Margin="0,6,0,0"
                     AutomationProperties.Name="{Binding RecordingFileNameLabel}"
                     ToolTip="{Binding RecordingFileNameLabel}"
                     Text="{Binding RecordingFileName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Margin="12,0,0,12">
            <TextBlock FontWeight="Bold" Text="{Binding AudioInputLabel}" />
            <ComboBox ItemsSource="{Binding AvailableAudioInputSources}"
                      SelectedItem="{Binding SelectedAudioInputSource}"
                      AutomationProperties.Name="{Binding AudioInputLabel}"
                      ToolTip="{Binding AudioInputLabel}"
                      Margin="0,6,0,0" />
        </StackPanel>

        <GroupBox Grid.Row="2"
                  Grid.ColumnSpan="2"
                  Header="{Binding AzureSettingsHeader}"
                  Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,12,8"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{Binding RecordingsFolderLabel}" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,12,8"
                         IsReadOnly="True"
                         AutomationProperties.Name="{Binding RecordingsFolderLabel}"
                         ToolTip="{Binding RecordingsFolderPath}"
                         Text="{Binding RecordingsFolderPath, Mode=OneWay}" />
                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Width="80"
                            Command="{Binding ChooseRecordingsFolderCommand}"
                            AutomationProperties.Name="{Binding ChooseButtonText}"
                            ToolTip="{Binding ChooseButtonText}"
                            Content="{Binding ChooseButtonText}" />
                    <Button Width="80"
                            Margin="8,0,0,0"
                            Command="{Binding OpenRecordingsFolderCommand}"
                            AutomationProperties.Name="{Binding OpenButtonText}"
                            ToolTip="{Binding OpenButtonText}"
                            Content="{Binding OpenButtonText}" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,12,8"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="Region" />
                <TextBox Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,0,12,8"
                          AutomationProperties.Name="Azure AI Service Region"
                          ToolTip="Azure AI Service Region"
                          Text="{Binding AzureRegion, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,0,12,8"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="{Binding ApiKeyLabel}" />
                 <PasswordBox Grid.Row="2"
                               Grid.Column="1"
                               Margin="0,0,12,8"
                               AutomationProperties.Name="{Binding ApiKeyLabel}"
                               ToolTip="{Binding ApiKeyLabel}"
                               local:PasswordBoxBindingBehavior.Attach="True"
                               local:PasswordBoxBindingBehavior.BoundPassword="{Binding AzureApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Row="1"
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        Width="120"
                        Command="{Binding SaveSettingsCommand}"
                        AutomationProperties.Name="{Binding SaveButtonText}"
                        ToolTip="{Binding SaveButtonText}"
                        Content="{Binding SaveButtonText}" />

                <TextBlock Grid.Row="3"
                           Grid.ColumnSpan="3"
                           Text="{Binding SettingsStatusMessage}"
                           TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3"
                     Grid.ColumnSpan="2"
                     Orientation="Horizontal"
                     Margin="0,0,0,12">
            <StackPanel Margin="0,0,12,0">
                <TextBlock FontWeight="Bold" Text="{Binding UiLanguageLabel}" />
                <ComboBox ItemsSource="{Binding AvailableUiLanguages}"
                          SelectedItem="{Binding SelectedUiLanguage}"
                          Width="120"
                          AutomationProperties.Name="{Binding UiLanguageLabel}"
                          ToolTip="{Binding UiLanguageLabel}"
                          Margin="0,6,0,0" />
            </StackPanel>
            <Button Width="120"
                    Command="{Binding StartCommand}"
                    AutomationProperties.Name="{Binding StartButtonText}"
                    ToolTip="{Binding StartButtonText}"
                    Content="{Binding StartButtonText}" />
            <Button Width="120"
                    Margin="12,0,0,0"
                    Command="{Binding StopCommand}"
                    AutomationProperties.Name="{Binding StopButtonText}"
                    ToolTip="{Binding StopButtonText}"
                    Content="{Binding StopButtonText}" />
            <TextBlock Margin="24,4,0,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Text="{Binding StatusMessage}" />
        </StackPanel>

        <GroupBox Grid.Row="4"
                  Grid.ColumnSpan="2"
                  Header="{Binding TranslationLogHeader}"
                  Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding TranslationLogs}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding SourceText}"
                                        Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding DataContext.SourceTextHeader, Source={x:Reference RootWindow}}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding TranslatedText}"
                                        Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding DataContext.TranslatedTextHeader, Source={x:Reference RootWindow}}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="5"
                  Grid.ColumnSpan="2"
                  Header="{Binding StatusLogHeader}">
            <ListBox ItemsSource="{Binding ActivityLogs}" />
        </GroupBox>
    </Grid>
</Window>
