<Window x:Class="SpeechTranslatorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpeechTranslatorDesktop.Behaviors"
        Title="{Binding MainWindowTitle}"
        Icon="Assets/AppIcon.ico"
        Height="760"
        Width="1120"
        MinHeight="620"
        MinWidth="900"
        Background="#F5F7FB">
    <Window.Resources>
        <local:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />

        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" Direction="270" Opacity="0.08" ShadowDepth="3" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0" />
            <GradientStop Color="#1E3A8A" Offset="0.62" />
            <GradientStop Color="#2563EB" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="DangerButton" BasedOn="{StaticResource ActionButton}" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="Foreground" Value="#991B1B" />
        </Style>

        <Style x:Key="LiveNoteCard" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>

        <Style x:Key="LiveNoteCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="LiveNoteText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style x:Key="ActivityPill" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{Binding TranslationLogRowHeight}" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="20"
                Background="{StaticResource HeroBrush}"
                CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Text="Speech Translator Desktop Plus" />
                    <TextBlock Margin="14,2,0,0"
                               Foreground="#CBD5E1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding HeroSubtitle}"
                               Text="{Binding HeroSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ActionButton}"
                            Click="ShowSettingsWindow"
                            AutomationProperties.Name="{Binding SettingsButtonText}"
                            ToolTip="{Binding SettingsButtonText}"
                            Content="{Binding SettingsButtonText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding RecognitionModeLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableRecognitionModes}"
                              SelectedItem="{Binding SelectedRecognitionMode}"
                              AutomationProperties.Name="{Binding RecognitionModeLabel}"
                              ToolTip="{Binding RecognitionModeLabel}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding SourceLanguageLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedSourceLanguage}"
                              AutomationProperties.Name="{Binding SourceLanguageLabel}"
                              ToolTip="{Binding SourceLanguageLabel}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding TargetLanguageLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedTargetLanguage}"
                              IsEnabled="{Binding IsTranslationMode}"
                              AutomationProperties.Name="{Binding TargetLanguageLabel}"
                              ToolTip="{Binding TargetLanguageLabel}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding AudioInputLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableAudioInputSources}"
                              SelectedItem="{Binding SelectedAudioInputSource}"
                              AutomationProperties.Name="{Binding AudioInputLabel}"
                              ToolTip="{Binding AudioInputLabel}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,0">
                    <CheckBox Margin="0,0,0,8"
                              IsChecked="{Binding IsRecordingSaveEnabled}"
                              AutomationProperties.Name="{Binding SaveRecordingLabel}"
                              ToolTip="{Binding SaveRecordingLabel}"
                              Content="{Binding SaveRecordingLabel}" />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="12,0,0,0"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Text="{Binding RecordingFileNamePreview}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding RecordingFileNameLabel}" />
                    </DockPanel>
                    <TextBox AutomationProperties.Name="{Binding RecordingFileNameLabel}"
                              ToolTip="{Binding RecordingFileNameLabel}"
                              Text="{Binding RecordingFileName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Grid Grid.Row="1"
                      Grid.Column="2"
                      Grid.ColumnSpan="2"
                      Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0"
                               HorizontalAlignment="Right">
                        <Button MinWidth="100"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartCommand}"
                                AutomationProperties.Name="{Binding StartButtonText}"
                                ToolTip="{Binding StartButtonText}"
                                Content="{Binding StartButtonText}" />
                        <Button MinWidth="100"
                                Margin="0,0,8,0"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding StopCommand}"
                                AutomationProperties.Name="{Binding StopButtonText}"
                                ToolTip="{Binding StopButtonText}"
                                Content="{Binding StopButtonText}" />
                        <Button MinWidth="110"
                                Margin="0,0,8,0"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding ClearLogsCommand}"
                                AutomationProperties.Name="{Binding ClearLogsButtonText}"
                                ToolTip="{Binding ClearLogsButtonText}"
                                Content="{Binding ClearLogsButtonText}" />
                    </WrapPanel>

                    <DockPanel Grid.Row="1"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Right">
                        <Border Margin="0,0,8,0"
                                Padding="10,6"
                                Background="#EFF6FF"
                                CornerRadius="10"
                                AutomationProperties.Name="{Binding StatusLabel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="#1D4ED8"
                                           Text="{Binding StatusLabel}" />
                                <TextBlock Margin="8,0,0,0"
                                           Foreground="#1E3A8A"
                                           Text="{Binding StatusMessage}" />
                            </StackPanel>
                        </Border>
                        <Button MinWidth="190"
                                Style="{StaticResource ActionButton}"
                                Click="ShowRecentTranslationsWindow"
                                AutomationProperties.Name="{Binding ShowRecentTranslationsButtonText}"
                                ToolTip="{Binding ShowRecentTranslationsButtonText}"
                                Content="{Binding ShowRecentTranslationsButtonText}" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Margin="0,0,0,16">
            <Expander x:Name="TranslationLogExpander"
                      IsExpanded="{Binding IsTranslationLogExpanded}"
                      AutomationProperties.AutomationId="TranslationLogExpander"
                      AutomationProperties.Name="{Binding TranslationLogHeader}">
                <Expander.Header>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding TranslationLogHeader}" />
                </Expander.Header>
                <DockPanel Margin="0,12,0,0">
                    <WrapPanel DockPanel.Dock="Top"
                               Margin="0,0,0,12">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding CopyAllLogsCommand}"
                                AutomationProperties.Name="{Binding CopyAllLogsButtonText}"
                                ToolTip="{Binding CopyAllLogsButtonText}"
                                Content="{Binding CopyAllLogsButtonText}" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource ActionButton}"
                                Command="{Binding CopyAllSourceLogsCommand}"
                                AutomationProperties.Name="{Binding CopyAllSourceLogsButtonText}"
                                ToolTip="{Binding CopyAllSourceLogsButtonText}"
                                Content="{Binding CopyAllSourceLogsButtonText}" />
                        <Button Style="{StaticResource ActionButton}"
                                Command="{Binding CopyAllTranslatedLogsCommand}"
                                AutomationProperties.Name="{Binding CopyAllTranslatedLogsButtonText}"
                                ToolTip="{Binding CopyAllTranslatedLogsButtonText}"
                                Visibility="{Binding TranslationColumnVisibility}"
                                Content="{Binding CopyAllTranslatedLogsButtonText}" />
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding TranslationLogs}"
                             SelectedItem="{Binding SelectedTranslationLog}"
                             BorderThickness="0"
                             Background="Transparent"
                             KeyboardNavigation.TabNavigation="Once"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Item"
                             AutomationProperties.Name="{Binding TranslationLogHeader}">
                        <ListBox.InputBindings>
                            <KeyBinding Key="C"
                                        Modifiers="Control"
                                        Command="{Binding CopySelectedTranslationLogCommand}" />
                            <KeyBinding Key="C"
                                        Modifiers="Control+Shift"
                                        Command="{Binding CopySelectedSourceTextCommand}" />
                            <KeyBinding Key="T"
                                        Modifiers="Control"
                                        Command="{Binding CopySelectedTranslatedTextCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LiveNoteCard}"
                                        AutomationProperties.Name="{Binding AutomationText}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Grid.RowSpan="4"
                                                    Grid.Column="1"
                                                    Margin="16,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.CopyTranslationLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding DataContext.CopyBlockButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="{Binding DataContext.CopyBlockButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Content="{Binding DataContext.CopyBlockButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource ActionButton}"
                                                    Command="{Binding DataContext.CopySourceTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding DataContext.CopySourceButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="{Binding DataContext.CopySourceButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Content="{Binding DataContext.CopySourceButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Style="{StaticResource ActionButton}"
                                                    Command="{Binding DataContext.CopyTranslatedTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding DataContext.CopyTranslationButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="{Binding DataContext.CopyTranslationButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Visibility="{Binding DataContext.TranslationColumnVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Content="{Binding DataContext.CopyTranslationButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Style="{StaticResource LiveNoteCaption}"
                                                   Text="{Binding Data.SourceTextHeader, Source={StaticResource DataContextProxy}}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Style="{StaticResource LiveNoteText}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplaySourceText}" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Margin="0,12,0,4"
                                                   Style="{StaticResource LiveNoteCaption}"
                                                   Visibility="{Binding Data.TranslationColumnVisibility, Source={StaticResource DataContextProxy}}"
                                                   Text="{Binding Data.TranslatedTextHeader, Source={StaticResource DataContextProxy}}" />
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Style="{StaticResource LiveNoteText}"
                                                   FontSize="16"
                                                   Visibility="{Binding Data.TranslationColumnVisibility, Source={StaticResource DataContextProxy}}"
                                                   Text="{Binding TranslatedText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Expander>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource Card}">
            <Expander IsExpanded="{Binding IsStatusLogExpanded}"
                      AutomationProperties.AutomationId="StatusLogExpander"
                      AutomationProperties.Name="{Binding StatusLogHeader}">
                <Expander.Header>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="{Binding StatusLogHeader}" />
                </Expander.Header>
                <ListBox Margin="0,8,0,0"
                         MaxHeight="128"
                         ItemsSource="{Binding ActivityLogs}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Item"
                         AutomationProperties.Name="{Binding StatusLogHeader}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ActivityPill}"
                                    AutomationProperties.Name="{Binding}">
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Foreground="#334155" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>
        </Border>
    </Grid>
</Window>
