<Window x:Class="SpeechTranslatorDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpeechTranslatorDesktop.Behaviors"
        Title="{Binding SettingsWindowTitle}"
        Icon="Assets/AppIcon.ico"
        Height="360"
        Width="760"
        MinHeight="320"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FB">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="ActionButton" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Border Margin="20"
            Padding="20"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Margin="0,0,0,16"
                       FontSize="22"
                       FontWeight="Bold"
                       Text="{Binding SettingsWindowTitle}" />

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding RecordingsFolderLabel}" />
                <TextBox IsReadOnly="True"
                         AutomationProperties.Name="{Binding RecordingsFolderLabel}"
                         ToolTip="{Binding RecordingsFolderPath}"
                         Text="{Binding RecordingsFolderPath, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,20,0,12">
                <Button Width="90"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding ChooseRecordingsFolderCommand}"
                        AutomationProperties.Name="{Binding ChooseButtonText}"
                        ToolTip="{Binding ChooseButtonText}"
                        Content="{Binding ChooseButtonText}" />
                <Button Width="90"
                        Margin="8,0,0,0"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding OpenRecordingsFolderCommand}"
                        AutomationProperties.Name="{Binding OpenButtonText}"
                        ToolTip="{Binding OpenButtonText}"
                        Content="{Binding OpenButtonText}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Region" />
                <TextBox AutomationProperties.Name="Azure AI Service Region"
                         ToolTip="Azure AI Service Region"
                         Text="{Binding AzureRegion, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding ApiKeyLabel}" />
                <PasswordBox AutomationProperties.Name="{Binding ApiKeyLabel}"
                             ToolTip="{Binding ApiKeyLabel}"
                             local:PasswordBoxBindingBehavior.Attach="True"
                             local:PasswordBoxBindingBehavior.BoundPassword="{Binding AzureApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <DockPanel Grid.Row="4" Grid.ColumnSpan="2">
                <TextBlock VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding SettingsStatusMessage}" />
                <Button DockPanel.Dock="Right"
                        Width="120"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveSettingsCommand}"
                        AutomationProperties.Name="{Binding SaveButtonText}"
                        ToolTip="{Binding SaveButtonText}"
                        Content="{Binding SaveButtonText}" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
