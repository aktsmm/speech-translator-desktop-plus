<Window x:Class="SpeechTranslatorDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpeechTranslatorDesktop.Behaviors"
        Title="{Binding SettingsWindowTitle}"
        Icon="Assets/AppIcon.ico"
        Height="660"
        Width="760"
        MinHeight="560"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FB">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="ActionButton" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Border Margin="20"
            Padding="20"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Margin="0,0,0,16"
                       FontSize="22"
                       FontWeight="Bold"
                       Text="{Binding SettingsWindowTitle}" />

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding UiLanguageLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableUiLanguages}"
                              SelectedItem="{Binding SelectedUiLanguage}"
                              AutomationProperties.Name="{Binding UiLanguageLabel}"
                              ToolTip="{Binding UiLanguageSettingsHint}" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"
                               Text="{Binding UiLanguageSettingsHint}" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,12"
                    Padding="12"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding SpeechProviderLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableSpeechProviders}"
                                  SelectedItem="{Binding SelectedSpeechProvider}"
                                  AutomationProperties.Name="{Binding SpeechProviderLabel}"
                                  ToolTip="{Binding SpeechProviderCurrentDescription}" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#334155"
                                   Text="{Binding SpeechProviderCurrentDescription}" />
                    </Grid>
                    <DockPanel Margin="0,8,0,0">
                        <Border DockPanel.Dock="Left"
                                Margin="0,0,12,0"
                                Padding="10,6"
                                Background="#DBEAFE"
                                CornerRadius="8">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="#1D4ED8"
                                       Text="{Binding SpeechProviderCurrentName}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#334155"
                                   Text="{Binding SpeechProviderCurrentDescription}" />
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Text="{Binding SpeechProviderRoadmapLabel}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Text="{Binding SpeechProviderRoadmap}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,12"
                        Visibility="{Binding GoogleProviderSettingsVisibility}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding GoogleProjectIdLabel}" />
                <TextBox AutomationProperties.Name="{Binding GoogleProjectIdLabel}"
                         ToolTip="{Binding GoogleProjectIdLabel}"
                         Text="{Binding GoogleProjectId, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding GoogleLocationLabel}" />
                        <TextBox AutomationProperties.Name="{Binding GoogleLocationLabel}"
                                 ToolTip="{Binding GoogleLocationLabel}"
                                 Text="{Binding GoogleLocation, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding GoogleSpeechModelLabel}" />
                        <TextBox AutomationProperties.Name="{Binding GoogleSpeechModelLabel}"
                                 ToolTip="{Binding GoogleSpeechModelLabel}"
                                 Text="{Binding GoogleSpeechModel, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="{Binding GoogleCredentialsPathLabel}" />
                <TextBox AutomationProperties.Name="{Binding GoogleCredentialsPathLabel}"
                         ToolTip="{Binding GoogleCredentialsHint}"
                         Text="{Binding GoogleCredentialsPath, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Text="{Binding GoogleCredentialsHint}" />
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,12,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding RecordingsFolderLabel}" />
                <TextBox IsReadOnly="True"
                         AutomationProperties.Name="{Binding RecordingsFolderLabel}"
                         ToolTip="{Binding RecordingsFolderPath}"
                         Text="{Binding RecordingsFolderPath, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,20,0,12">
                <Button Width="90"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding ChooseRecordingsFolderCommand}"
                        AutomationProperties.Name="{Binding ChooseButtonText}"
                        ToolTip="{Binding ChooseButtonText}"
                        Content="{Binding ChooseButtonText}" />
                <Button Width="90"
                        Margin="8,0,0,0"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding OpenRecordingsFolderCommand}"
                        AutomationProperties.Name="{Binding OpenButtonText}"
                        ToolTip="{Binding OpenButtonText}"
                        Content="{Binding OpenButtonText}" />
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Visibility="{Binding AzureProviderSettingsVisibility}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding AzureRegionLabel}" />
                <TextBox AutomationProperties.Name="{Binding AzureRegionLabel}"
                         ToolTip="{Binding AzureRegionLabel}"
                         Text="{Binding AzureRegion, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Visibility="{Binding AzureProviderSettingsVisibility}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding ApiKeyLabel}" />
                <PasswordBox AutomationProperties.Name="{Binding ApiKeyLabel}"
                             ToolTip="{Binding ApiKeyLabel}"
                             local:PasswordBoxBindingBehavior.Attach="True"
                             local:PasswordBoxBindingBehavior.BoundPassword="{Binding AzureApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <DockPanel Grid.Row="7" Grid.ColumnSpan="2">
                <TextBlock VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding SettingsStatusMessage}" />
                <Button DockPanel.Dock="Right"
                        Width="120"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveSettingsCommand}"
                        AutomationProperties.Name="{Binding SaveButtonText}"
                        ToolTip="{Binding SaveButtonText}"
                        Content="{Binding SaveButtonText}" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
